[Unit]
Description=Cooling Tank Monitor - Next.js web app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tank-monitoring
EnvironmentFile=/opt/tank-monitoring/.env
ExecStart=/usr/bin/env PORT=3000 /opt/tank-monitoring/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=5
User=tankmon
Group=tankmon
NoNewPrivileges=true
StandardOutput=append:/var/log/tank-web.log
StandardError=append:/var/log/tank-web.log

[Install]
WantedBy=multi-user.target
