# ---------- HiveMQ Cloud ----------
# Port 8884 = MQTT over WebSocket + TLS (dipakai browser)
NEXT_PUBLIC_MQTT_URL=wss://xxxxxxxx.s1.eu.hivemq.cloud:8884/mqtt
# Gunakan credential TERPISAH yang read-only untuk browser (lihat catatan keamanan di README)
NEXT_PUBLIC_MQTT_USERNAME=pwa_readonly
NEXT_PUBLIC_MQTT_PASSWORD=ganti_ini
# Topic: {prefix}/{tankId}/suhu — contoh: susu/tank-a/suhu
NEXT_PUBLIC_MQTT_TOPIC_PREFIX=susu

# ---------- Web Push (VAPID) ----------
# Generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com

# ---------- Penyimpanan server (tanki + langganan push) ----------
# WAJIB diisi kalau deploy ke Vercel — filesystem-nya read-only, jadi
# data/store.json tidak bisa ditulis dan /api/push/subscribe akan selalu
# gagal. Tambah integrasi "KV" (Upstash Redis) dari tab Storage di
# dashboard Vercel, dua env var ini otomatis terisi.
# Kosongkan kalau deploy di VPS (fallback otomatis ke data/store.json).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---------- Worker (VPS) ----------
# Port 8883 = MQTT over TLS (native, dipakai worker Node)
MQTT_URL=mqtts://xxxxxxxx.s1.eu.hivemq.cloud:8883
MQTT_USERNAME=worker
MQTT_PASSWORD=ganti_ini
NEXT_PUBLIC_MQTT_TOPIC_PREFIX=susu
# Endpoint app untuk ambil daftar subscription + konfigurasi tank
APP_BASE_URL=http://127.0.0.1:3000
WORKER_TOKEN=ganti_dengan_token_acak_panjang
